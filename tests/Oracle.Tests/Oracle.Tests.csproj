<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>

  <!--
    Compile the production classifier against a mirrored AbilityTrackSource enum (defined in this
    project) so the pure logic is unit-tested without loading Unity's Assembly-CSharp under net8.
  -->
  <ItemGroup>
    <Compile Include="..\..\src\PerkClassification.cs" Link="PerkClassification.cs" />
    <!-- PerkPoolResolver is the pure ordering/filter core (no Unity/TFTV types), so it links and
         unit-tests cleanly under net8 with injected fakes. -->
    <Compile Include="..\..\src\PerkPoolResolver.cs" Link="PerkPoolResolver.cs" />
    <!-- PerkSwapDecision is the pure allow/deny gate for perk swaps (no Unity/TFTV types). -->
    <Compile Include="..\..\src\PerkSwapDecision.cs" Link="PerkSwapDecision.cs" />
    <!-- ClassPerkResolver is the pure class-track ordering/dedup core (no Unity/TFTV types). -->
    <Compile Include="..\..\src\ClassPerkResolver.cs" Link="ClassPerkResolver.cs" />
    <!-- EventOutcomeData (POCO DTO) + EventOutcomePreview (pure formatter) are engine-free,
         so they link and unit-test under net8 exactly like PerkPoolResolver. -->
    <Compile Include="..\..\src\EventOutcomeData.cs" Link="EventOutcomeData.cs" />
    <Compile Include="..\..\src\EventOutcomePreview.cs" Link="EventOutcomePreview.cs" />
    <!-- EventOutcomeFormat (pure authored-line formatting primitives) is engine-free, so it
         links and unit-tests under net8 exactly like EventOutcomePreview. -->
    <Compile Include="..\..\src\EventOutcomeFormat.cs" Link="EventOutcomeFormat.cs" />
    <!-- VariableNarratives (pure story-variable id -> narrative phrase/suffix mapping) is engine-free
         (only depends on EventOutcomeFormat), so it links and unit-tests under net8. -->
    <Compile Include="..\..\src\VariableNarratives.cs" Link="VariableNarratives.cs" />
  </ItemGroup>
</Project>
